diff --git a/arch/arm64/Makefile b/arch/arm64/Makefile
index 4b36e88b5..aa0677de2 100644
--- a/arch/arm64/Makefile
+++ b/arch/arm64/Makefile
@@ -78,7 +78,13 @@ ifeq ($(CONFIG_COMPAT_VDSO), y)
     export CLANG_TARGET_ARM32 := --target=$(notdir $(CLANG_TRIPLE_ARM32:%-=%))
     export GCC_TOOLCHAIN32_DIR := $(dir $(shell which $(CROSS_COMPILE_ARM32)ld))
     export GCC_TOOLCHAIN32 := $(realpath $(GCC_TOOLCHAIN32_DIR)/..)
-    export CLANG_PREFIX32 := --prefix=$(GCC_TOOLCHAIN32_DIR)
+    # GCC_TOOLCHAIN32_DIR is a directory (/usr/bin/), not a tool prefix. Passing
+    # it to --prefix makes clang look for an assembler literally named "as" in
+    # that directory, which resolves to the host aarch64 assembler; the ARM32
+    # vDSO objects then fail to assemble with "-mfloat-abi=soft" being
+    # unrecognised. Append the tool prefix, as the main Makefile does for the
+    # 64-bit toolchain.
+    export CLANG_PREFIX32 := --prefix=$(GCC_TOOLCHAIN32_DIR)$(notdir $(CROSS_COMPILE_ARM32))
     export CLANG_GCC32_TC := --gcc-toolchain=$(GCC_TOOLCHAIN32)
     export CONFIG_VDSO32 := y
     vdso32 := -DCONFIG_VDSO32=1
